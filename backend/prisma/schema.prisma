generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(150)
  legalName String?  @map("legal_name") @db.VarChar(200)
  taxId     String?  @map("tax_id") @db.VarChar(30)
  email     String?  @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  address   String?
  city      String?  @db.VarChar(100)
  country   String?  @db.VarChar(80)
  currency  String   @default("COP") @db.VarChar(3)
  timezone  String   @default("America/Bogota") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles      Role[]
  categories Category[]
  suppliers  Supplier[]
  customers  Customer[]
  warehouses Warehouse[]

  @@map("companies")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique @db.VarChar(150)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(80)
  lastName        String    @map("last_name") @db.VarChar(80)
  phone           String?   @db.VarChar(30)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  companyRoles UserCompanyRole[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  company     Company? @relation(fields: [companyId], references: [id])
  name        String   @db.VarChar(80)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userCompanyRoles UserCompanyRole[]

  @@map("roles")
}

model UserCompanyRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_company_roles")
}

model Category {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id])
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("categories")
}

model Unit {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(50)
  abbreviation String   @db.VarChar(15)
  createdAt    DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("units")
}

model Product {
  id          String    @id @default(uuid())
  categoryId  String    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id])
  unitId      String    @map("unit_id")
  unit        Unit      @relation(fields: [unitId], references: [id])
  sku         String    @db.VarChar(60)
  barcode     String?   @db.VarChar(50)
  name        String    @db.VarChar(200)
  description String?
  costPrice   Decimal   @map("cost_price") @db.Decimal(14, 2)
  salePrice   Decimal   @map("sale_price") @db.Decimal(14, 2)
  minStock    Decimal   @default(0) @map("min_stock") @db.Decimal(12, 3)
  isActive    Boolean   @default(true) @map("is_active")
  trackStock  Boolean   @default(true) @map("track_stock")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("products")
}

model Supplier {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id])
  name        String    @db.VarChar(150)
  taxId       String?   @map("tax_id") @db.VarChar(30)
  email       String?   @db.VarChar(150)
  phone       String?   @db.VarChar(30)
  address     String?
  contactName String?   @map("contact_name") @db.VarChar(120)
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Customer {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  company      Company   @relation(fields: [companyId], references: [id])
  code         String?   @db.VarChar(30)
  name         String    @db.VarChar(150)
  taxId        String?   @map("tax_id") @db.VarChar(30)
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  address      String?
  city         String?   @db.VarChar(100)
  creditLimit  Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  paymentTerms String?   @map("payment_terms") @db.VarChar(50)
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  interactions CustomerInteraction[]
  salesOrders  SalesOrder[]

  @@map("customers")
}

model CustomerInteraction {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id])
  userId          String   @map("user_id")
  type            String   @db.VarChar(30)
  subject         String?  @db.VarChar(200)
  content         String
  interactionDate DateTime @map("interaction_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("customer_interactions")
}

model Warehouse {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @db.VarChar(120)
  code      String?  @db.VarChar(20)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model StockLevel {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  warehouseId      String    @map("warehouse_id")
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  quantity         Decimal   @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal   @default(0) @map("reserved_quantity") @db.Decimal(14, 3)
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("stock_levels")
}

model StockMovement {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  warehouseId   String    @map("warehouse_id")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  type          String    @db.VarChar(30)
  quantity      Decimal   @db.Decimal(14, 3)
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(14, 2)
  referenceType String?   @map("reference_type") @db.VarChar(40)
  referenceId   String?   @map("reference_id")
  notes         String?
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("stock_movements")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  supplierId   String    @map("supplier_id")
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  orderNumber  String    @map("order_number") @db.VarChar(30)
  status       String    @default("draft") @db.VarChar(30)
  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  subtotal     Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount    Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total        Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String        @map("product_id")
  quantity         Decimal       @db.Decimal(14, 3)
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(14, 2)
  taxRate          Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal         Decimal       @db.Decimal(14, 2)
  total            Decimal       @db.Decimal(14, 2)

  @@map("purchase_order_items")
}

model SalesOrder {
  id             String    @id @default(uuid())
  customerId     String    @map("customer_id")
  customer       Customer  @relation(fields: [customerId], references: [id])
  orderNumber    String    @map("order_number") @db.VarChar(30)
  status         String    @default("quote") @db.VarChar(30)
  orderDate      DateTime  @map("order_date") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  items    SalesOrderItem[]
  invoices Invoice[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id                String     @id @default(uuid())
  salesOrderId      String     @map("sales_order_id")
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId         String     @map("product_id")
  quantity          Decimal    @db.Decimal(14, 3)
  deliveredQuantity Decimal    @default(0) @map("delivered_quantity") @db.Decimal(14, 3)
  unitPrice         Decimal    @map("unit_price") @db.Decimal(14, 2)
  taxRate           Decimal    @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discountRate      Decimal    @default(0) @map("discount_rate") @db.Decimal(5, 2)
  subtotal          Decimal    @db.Decimal(14, 2)
  total             Decimal    @db.Decimal(14, 2)

  @@map("sales_order_items")
}

model Invoice {
  id             String      @id @default(uuid())
  salesOrderId   String?     @map("sales_order_id")
  salesOrder     SalesOrder? @relation(fields: [salesOrderId], references: [id])
  invoiceNumber  String      @map("invoice_number") @db.VarChar(30)
  status         String      @default("draft") @db.VarChar(30)
  issueDate      DateTime    @map("issue_date") @db.Date
  dueDate        DateTime?   @map("due_date") @db.Date
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal     @default(0) @map("paid_amount") @db.Decimal(14, 2)
  notes          String?
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @map("payment_date") @db.Date
  paymentMethod String   @map("payment_method") @db.VarChar(40)
  reference     String?  @db.VarChar(100)
  notes         String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("payments")
}