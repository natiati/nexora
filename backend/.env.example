# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/nexora"

# Solo para npm test: base de datos aparte, nunca la de trabajo
TEST_DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/nexora_test"

# Clave secreta para firmar los JWT (larga y aleatoria)
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# Opcional: empresa que recibe las solicitudes de demo de la landing (por defecto, la primera creada)
# LEADS_COMPANY_ID=""

# Puerto del servidor
PORT=3000

# Origen(es) permitido(s) para el frontend, separados por coma
CORS_ORIGIN="http://localhost:5173"

# URL del frontend para los enlaces de los correos (por defecto, el primer CORS_ORIGIN)
# FRONTEND_URL="http://localhost:5173"

# Servicio de correo (SMTP). Sin SMTP_HOST la app funciona, pero no envía correos.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una contraseña de aplicación en SMTP_PASS
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# Remitente (por defecto, SMTP_USER)
# MAIL_FROM="Nexora <tu-correo@ejemplo.com>"
# A dónde llegan los avisos de solicitudes de demo (por defecto, SMTP_USER)
# MAIL_NOTIFY_TO=""
